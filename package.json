{
  "name": "gb-meat-grinder",
  "version": "0.0.0",
  "private": true,
  "description": "Guild Ball attack calculator: expected damage across every playbook result.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run verify && wrangler deploy",
    "verify": "npm run check && npm run typecheck && npm test && npm run build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cckarchev/shared": "github:cckarchev/cck-shared#v1.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
