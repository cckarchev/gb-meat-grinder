{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@cckarchev/shared/biome"],
  "files": {
    "includes": ["**", "!public"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              // The context passes on useReducer's dispatch, whose identity never changes.
              {
                "name": "useMeatGrinderSimulation",
                "stableResult": ["dispatch"]
              }
            ]
          }
        }
      }
    }
  }
}
